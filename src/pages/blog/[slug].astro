---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getAllBlogPosts, getBlogPostBySlug } from '../../lib/supabase';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map(post => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const parseMarkdown = (content: string) => {
  return content
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/^(?!<[h|p])/gim, '<p>')
    .replace(/(?![h|p]>)$/gim, '</p>');
};
---

<BlogLayout title={`${post.title} - TechPulse`} description={post.excerpt}>
  <article class="article">
    <header class="article-header">
      <div class="container">
        <div class="article-meta-top">
          <span class="article-category">{post.category}</span>
          <div class="article-stats">
            <time datetime={post.published_at} class="article-date">
              {formatDate(post.published_at)}
            </time>
            <span class="divider">·</span>
            <span class="read-time">{post.read_time_minutes} min read</span>
          </div>
        </div>
        <h1 class="article-title">{post.title}</h1>
        <p class="article-excerpt">{post.excerpt}</p>
        <div class="author-section">
          <img
            src={post.author.avatar_url}
            alt={post.author.name}
            class="author-avatar-large"
            loading="eager"
          />
          <div class="author-details">
            <h3 class="author-name">{post.author.name}</h3>
            <p class="author-bio">{post.author.bio}</p>
            {post.author.twitter_handle && (
              <a
                href={`https://twitter.com/${post.author.twitter_handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="author-twitter"
              >
                @{post.author.twitter_handle}
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <div class="article-image-wrapper">
      <img
        src={post.cover_image_url}
        alt={post.title}
        class="article-image"
        loading="eager"
      />
    </div>

    <div class="article-content">
      <div class="container-narrow">
        <div class="prose" set:html={parseMarkdown(post.content)} />

        {post.tags && post.tags.length > 0 && (
          <div class="article-tags">
            <h3 class="tags-title">Tags</h3>
            <div class="tags-list">
              {post.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <footer class="article-footer">
      <div class="container-narrow">
        <div class="author-card">
          <img
            src={post.author.avatar_url}
            alt={post.author.name}
            class="author-card-avatar"
            loading="lazy"
          />
          <div class="author-card-content">
            <h3 class="author-card-name">About {post.author.name}</h3>
            <p class="author-card-bio">{post.author.bio}</p>
            {post.author.twitter_handle && (
              <a
                href={`https://twitter.com/${post.author.twitter_handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="author-card-twitter"
              >
                Follow on Twitter
              </a>
            )}
          </div>
        </div>
        <div class="article-nav">
          <a href="/" class="back-link">
            ← Back to all articles
          </a>
        </div>
      </div>
    </footer>
  </article>
</BlogLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .container-narrow {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .article-header {
    padding: 48px 0 32px;
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
  }

  .article-category {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .article-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-text-tertiary);
    font-size: 15px;
  }

  .divider {
    color: var(--color-border);
  }

  .article-title {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .article-excerpt {
    font-size: 20px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 40px;
  }

  .author-section {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 32px;
    background: var(--color-bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--color-border);
  }

  .author-avatar-large {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: var(--shadow-md);
  }

  .author-details {
    flex: 1;
  }

  .author-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 8px;
  }

  .author-bio {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }

  .author-twitter {
    display: inline-block;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: var(--transition);
  }

  .author-twitter:hover {
    color: var(--color-primary-hover);
  }

  .article-image-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 64px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .article-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-content {
    padding: 0 0 64px;
  }

  .prose {
    font-size: 18px;
    line-height: 1.8;
    color: var(--color-text);
  }

  .prose :global(h1) {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
    margin: 48px 0 24px;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .prose :global(h2) {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    margin: 40px 0 20px;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .prose :global(h3) {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.4;
    margin: 32px 0 16px;
    color: var(--color-text);
  }

  .prose :global(p) {
    margin-bottom: 24px;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .article-tags {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }

  .tags-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 16px;
    color: var(--color-text);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tag {
    display: inline-block;
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--color-border);
    transition: var(--transition);
  }

  .tag:hover {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .article-footer {
    padding: 64px 0;
    border-top: 1px solid var(--color-border);
  }

  .author-card {
    display: flex;
    gap: 24px;
    padding: 40px;
    background: var(--color-bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--color-border);
    margin-bottom: 32px;
  }

  .author-card-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid white;
    box-shadow: var(--shadow-md);
    flex-shrink: 0;
  }

  .author-card-content {
    flex: 1;
  }

  .author-card-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 12px;
  }

  .author-card-bio {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
  }

  .author-card-twitter {
    display: inline-block;
    background: var(--color-primary);
    color: white;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    transition: var(--transition);
  }

  .author-card-twitter:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
  }

  .article-nav {
    text-align: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--color-primary);
    transform: translateX(-4px);
  }

  @media (max-width: 768px) {
    .article-header {
      padding: 32px 0 24px;
    }

    .article-title {
      font-size: 32px;
      margin-bottom: 16px;
    }

    .article-excerpt {
      font-size: 17px;
      margin-bottom: 32px;
    }

    .author-section {
      flex-direction: column;
      text-align: center;
      padding: 24px;
    }

    .author-avatar-large {
      width: 64px;
      height: 64px;
    }

    .author-name {
      font-size: 18px;
    }

    .author-bio {
      font-size: 14px;
    }

    .article-image-wrapper {
      margin-bottom: 48px;
      border-radius: 12px;
    }

    .article-content {
      padding: 0 0 48px;
    }

    .prose {
      font-size: 17px;
    }

    .prose :global(h1) {
      font-size: 28px;
      margin: 40px 0 20px;
    }

    .prose :global(h2) {
      font-size: 24px;
      margin: 32px 0 16px;
    }

    .prose :global(h3) {
      font-size: 20px;
      margin: 24px 0 12px;
    }

    .article-tags {
      margin-top: 48px;
      padding-top: 24px;
    }

    .article-footer {
      padding: 48px 0;
    }

    .author-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 32px 24px;
    }

    .author-card-avatar {
      width: 80px;
      height: 80px;
    }

    .author-card-name {
      font-size: 20px;
    }

    .author-card-bio {
      font-size: 15px;
    }
  }
</style>
